# Postgres connection string from your Neon project (Dashboard → Connection Details).
# Use the pooled connection string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used by Better Auth to sign sessions/cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL Better Auth uses to build callback/redirect URLs.
# Local dev: http://localhost:3000
# Production: your deployed URL, e.g. https://your-app.vercel.app
# On Render this can be left unset: the app falls back to RENDER_EXTERNAL_URL.
BETTER_AUTH_URL=http://localhost:3000
