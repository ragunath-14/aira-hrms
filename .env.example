# Postgres connection string from your Neon project (Dashboard → Connection Details).
# Use the pooled connection string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used by Better Auth to sign sessions/cookies (min 32 chars; the app
# refuses to start in production with a shorter one). Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL Better Auth uses to build callback/redirect URLs.
# Local dev: http://localhost:3000
# Production: your deployed URL, e.g. https://your-app.onrender.com
# On Render this can be left unset: the app falls back to RENDER_EXTERNAL_URL.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated extra origins allowed to make auth requests.
# Use this when testing via a tunnel (ngrok, localtunnel, etc.).
# Example: https://abc123.ngrok-free.dev
BETTER_AUTH_TRUSTED_ORIGINS=

# --- One-off: first administrator (npm run db:create-admin) -----------------
# Pass these on the command line or in your shell for that single run; do not
# keep the password in a committed file. The password is stored hashed.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# COMPANY_NAME=

# Video meetings and calls (Workplace page). Rooms are created on Jitsi Meet.
# Leave unset to use the free public service; point it at your own Jitsi
# server (https only) to keep calls in-house.
# MEETING_BASE_URL=https://meet.jit.si

# Keep Neon awake with a repeating ping (off by default in production).
# DB_KEEP_WARM=false
